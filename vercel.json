{
  "functions": { "api/fundamentals.js": { "includeFiles": "data/**" } },
  "headers": [
    { "source": "/logos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    {
      "source": "/(.*)",
      "headers": [
    { "source": "/logos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
